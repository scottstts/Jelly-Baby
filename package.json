{
  "name": "jelly_baby",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src scripts eslint.config.js",
    "typecheck": "tsc --noEmit",
    "build:model": "node scripts/build-model.mjs",
    "build:kernel": "node scripts/build-kernel.mjs",
    "test": "node scripts/test-suite.mjs",
    "test:physics": "node --experimental-strip-types scripts/verify-physics.mjs",
    "test:swing": "node --experimental-strip-types scripts/verify-swing.mjs",
    "test:tricycle": "node --experimental-strip-types scripts/verify-tricycle.mjs",
    "test:toy-geometry": "node --experimental-strip-types scripts/verify-toy-geometry.mjs",
    "test:portal-collision": "node --experimental-strip-types scripts/verify-portal-collision.mjs",
    "test:toy-driving": "node --experimental-strip-types scripts/verify-toy-driving.mjs",
    "test:world-travel": "node --experimental-strip-types scripts/verify-world-travel.mjs",
    "test:trampoline": "node --experimental-strip-types scripts/verify-trampoline.mjs",
    "test:bed": "node --experimental-strip-types scripts/verify-bed.mjs",
    "test:wearables": "node --experimental-strip-types scripts/verify-wearables.mjs",
    "test:blanket-shadows": "node --experimental-strip-types scripts/verify-blanket-shadows.mjs",
    "test:facility-collision": "node --experimental-strip-types scripts/verify-facility-collision.mjs",
    "test:collision-broadphase": "node --experimental-strip-types scripts/verify-collision-broadphase.mjs",
    "test:collision-hierarchy": "node --experimental-strip-types scripts/verify-collision-hierarchy.mjs",
    "test:native-collision": "node --experimental-strip-types scripts/verify-native-collision.mjs",
    "test:collision-warmup": "node --experimental-strip-types scripts/verify-collision-warmup.mjs",
    "test:render-warmup": "node --experimental-strip-types scripts/verify-render-warmup.mjs",
    "test:lighting": "node --experimental-strip-types scripts/verify-lighting.mjs",
    "test:facility-shadows": "node --experimental-strip-types scripts/verify-facility-shadows.mjs",
    "test:facility-sound": "node --experimental-strip-types scripts/verify-facility-sound.mjs",
    "test:multitouch": "node --experimental-strip-types scripts/verify-multitouch.mjs",
    "test:orientation": "node --experimental-strip-types scripts/verify-orientation.mjs",
    "test:deformation": "node --experimental-strip-types scripts/verify-deformation.mjs",
    "test:performance": "node --experimental-strip-types scripts/verify-performance.mjs",
    "benchmark": "node --experimental-strip-types scripts/benchmark.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/delaunator": "^5.0.3",
    "@types/three": "^0.185.4",
    "eslint": "^10.9.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "delaunator": "^5.1.0",
    "three": "^0.185.0"
  }
}
